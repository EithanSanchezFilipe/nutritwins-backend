{
  "compilerOptions": {
    "target": "ES2020",
    "moduleResolution": "node",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    // Add this to help TS find your custom definitions
    "typeRoots": ["./node_modules/@types", "./src/types"] 
  },
  "include": ["src/**/*"] 
}